# MySQL Database Configuration (Used by Netlify Serverless Functions)
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=your_secure_password_here

# API & Mode Settings
# Set VITE_USE_LIVE_API to 'true' if connecting to deployed Netlify Functions + Live MySQL
# Leave as 'false' or blank for automatic client-side demo mode fallback
VITE_USE_LIVE_API=false
VITE_API_BASE_URL=/.netlify/functions
